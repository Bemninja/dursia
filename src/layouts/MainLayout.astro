---
import "../styles/tailwind.css";
const { title } = Astro.props;
---

<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/dursia-logo.png" />
    <link rel="apple-touch-icon" href="/dursia-logo.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>

  <!-- 
    ÆNDRING 1: Fjerner `overflow-hidden` fra <body> og tilføjer `min-h-screen`.
    Det sikrer, at mobiler kan scrolle, hvis indholdet er højere end skærmen,
    uden at baggrundskortet hopper eller ødelægges.
  -->
  <body class="m-0 p-0 min-h-screen bg-[#0a1628] relative overflow-x-hidden">
    <!-- Moving map background (bliver stående i baggrunden under scroll) -->
    <div class="fixed inset-0 overflow-hidden z-0 pointer-events-none">
      <img src="/assets/images/dursiaweb-map2-redroute.png" alt="Map background" class="absolute top-0 left-0 h-full w-[180%] sm:w-[140%] md:w-[120%] max-w-none object-cover animate-map-move" />
    </div>

    <!-- Page content (får fuld bredde og responsiv padding i siderne) -->
    <div class="relative z-10 w-full min-h-screen">
      <slot />
    </div>
  </body>
</html>

<style is:global>
  @keyframes map-move {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-16%, 0, 0);
    }
  }

  .animate-map-move {
    animation: map-move 90s linear infinite alternate;
    will-change: transform;
    backface-visibility: hidden;
    transform: translate3d(0, 0, 0);
  }
</style>
