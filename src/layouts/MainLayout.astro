---
import "../styles/tailwind.css";
const { title } = Astro.props;
---

<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/dursia-logo.png" />
    <link rel="apple-touch-icon" href="/dursia-logo.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>

  <body class="m-0 p-0 min-h-screen bg-[#0a1628] relative overflow-x-hidden">
    <!-- Moving map background -->
    <div class="fixed inset-0 overflow-hidden z-0 pointer-events-none">
      <img src="/assets/images/dursiaweb-map2-redroute.png" alt="Map background" class="absolute top-0 left-0 h-full w-[180%] sm:w-[140%] md:w-[120%] max-w-none object-cover animate-map-move" />
    </div>

    <!-- FÆLLES HJØRNE-LOGO (Fastplaceret øverst til venstre på alle sider) -->
    <header class="fixed top-4 left-4 md:top-6 md:left-6 z-50">
      <a href="/" class="block hover:opacity-80 transition-opacity">
        <img src="/dursia-logo.png" alt="DURSIA Logo" class="h-8 md:h-11 w-auto object-contain drop-shadow-md" />
      </a>
    </header>

    <!-- Page content -->
    <div class="relative z-10 w-full min-h-screen">
      <slot />
    </div>
  </body>
</html>

<style is:global>
  @keyframes map-move {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-16%, 0, 0);
    }
  }

  .animate-map-move {
    animation: map-move 90s linear infinite alternate;
    will-change: transform;
    backface-visibility: hidden;
    transform: translate3d(0, 0, 0);
  }
</style>
