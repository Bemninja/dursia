---
import "../styles/tailwind.css";
const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/dursia-logo.png" />
    <link rel="apple-touch-icon" href="/dursia-logo.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>

  <body class="m-0 p-0 overflow-hidden bg-[#0a1628]">
    <!-- Moving map background (shared on all pages) -->
    <div class="fixed inset-0 overflow-hidden z-0">
      <img src="/assets/images/dursiaweb-map2-redroute.png" alt="Map background" class="absolute top-0 left-0 h-full w-[120%] max-w-none object-cover animate-map-move" style="will-change: transform;" />
    </div>

    <!-- Page content -->
    <div class="relative z-10">
      <slot />
    </div>
  </body>
</html>

<style is:global>
  @keyframes map-move {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-16%, 0, 0);
    }
  }

  .animate-map-move {
    animation: map-move 90s linear infinite alternate;
    will-change: transform;
    backface-visibility: hidden;
    transform: translate3d(0, 0, 0);
  }
</style>
