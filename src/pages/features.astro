---
import MainLayout from "../layouts/MainLayout.astro";
import { Image } from "astro:assets";
import dursiaLogo from "../../src/images/dursialogo.png";
import IconButton from "../components/IconButton.astro";
---

<MainLayout title="DURSIA - Features">
  <main class="w-full min-h-screen px-4 md:px-12 lg:px-24 py-12">
    <!-- ÉN SAMLET FLUID SECTION (Fungerer glidende fra mobil til desktop) -->
    <section class="max-w-7xl mx-auto grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 md:gap-12 items-center justify-items-center">
      <!-- Billeder (Skalerer blødt og automatisk via max-h-[70vh] og transition) -->
      <img src="../assets/images/dursia1.png" alt="dursia screenshot" class="w-auto max-h-[65vh] md:max-h-[75vh] object-contain transition-all duration-300" />
      <img src="../assets/images/dursia2.png" alt="dursia screenshot" class="w-auto max-h-[65vh] md:max-h-[75vh] object-contain transition-all duration-300" />
      <img src="../assets/images/dursia3.png" alt="dursia screenshot" class="w-auto max-h-[65vh] md:max-h-[75vh] object-contain transition-all duration-300" />

      <img src="../assets/images/dursia4.png" alt="dursia screenshot" class="w-auto max-h-[65vh] md:max-h-[75vh] object-contain transition-all duration-300" />
      <img src="../assets/images/dursia5.png" alt="dursia screenshot" class="w-auto max-h-[65vh] md:max-h-[75vh] object-contain transition-all duration-300" />
      <img src="../assets/images/dursia6.png" alt="dursia screenshot" class="w-auto max-h-[65vh] md:max-h-[75vh] object-contain transition-all duration-300" />

      <img src="../assets/images/dursia7.png" alt="dursia screenshot" class="w-auto max-h-[65vh] md:max-h-[75vh] object-contain transition-all duration-300" />
      <img src="../assets/images/dursia8.png" alt="dursia screenshot" class="w-auto max-h-[65vh] md:max-h-[75vh] object-contain transition-all duration-300" />
      <img src="../assets/images/dursia9.png" alt="dursia screenshot" class="w-auto max-h-[65vh] md:max-h-[75vh] object-contain transition-all duration-300" />

      <img src="../assets/images/dursia10.png" alt="dursia screenshot" class="w-auto max-h-[65vh] md:max-h-[75vh] object-contain transition-all duration-300" />
      <img src="../assets/images/dursia11.png" alt="dursia screenshot" class="w-auto max-h-[65vh] md:max-h-[75vh] object-contain transition-all duration-300" />

      <!-- Logo -->
      <a href="/" class="col-span-1 sm:col-span-2 lg:col-span-1 flex justify-center my-4">
        <Image class="max-w-[200px] md:max-w-[280px] object-contain" src={dursiaLogo} alt="dursia logo" />
      </a>

      <!-- Poster (Fyldig bredde i bunden) -->
      <div class="col-span-1 sm:col-span-2 lg:col-span-3 flex justify-center mt-8">
        <img src="../assets/images/DURSIA-art-nouveau-poster.jpeg" alt="DURSIA art nouveau poster" class="w-auto max-h-[75vh] object-contain rounded-lg shadow-xl" />
      </div>
    </section>

    <!-- Tilbage-knap -->
    <IconButton href="/">
      <img src="../assets/icons/arrow-back.svg" alt="back arrow" class="fixed bottom-4 right-4 z-50 w-14 h-14 md:bottom-8 md:right-8 rounded-full bg-black/30 p-2 backdrop-blur-sm hover:bg-black/50 transition" />
    </IconButton>
  </main>
</MainLayout>
