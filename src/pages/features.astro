---
import MainLayout from "../layouts/MainLayout.astro";
import { Image } from "astro:assets";
import dursiaLogo from "../../src/images/dursialogo.png";
import IconButton from "../components/IconButton.astro";
---

<MainLayout title="DURSIA - Features">
  <!-- 
    1. tabindex="0" gør main-elementet fokuserbart for piletaster.
    2. focus:outline-none fjerner den grimme markering/ramme ved fokus.
    3. snap-y snap-mandatory med scroll-smooth sikrer glidende snap.
  -->
  <main id="feature-scroll-container" tabindex="0" class="w-full h-screen h-[100dvh] overflow-y-scroll snap-y snap-mandatory scroll-smooth focus:outline-none px-4 md:px-12 lg:px-24">
    <!-- MOBIL VIEW: Hver sektion fylder nøjagtig 100dvh med snap-always -->
    <div class="md:hidden">
      <section class="snap-start snap-always h-[100dvh] w-full flex items-center justify-center py-6">
        <img src="../assets/images/dursia1.png" alt="dursia screenshot" class="max-h-[80vh] w-auto object-contain" />
      </section>

      <section class="snap-start snap-always h-[100dvh] w-full flex items-center justify-center py-6">
        <img src="../assets/images/dursia2.png" alt="dursia screenshot" class="max-h-[80vh] w-auto object-contain" />
      </section>

      <section class="snap-start snap-always h-[100dvh] w-full flex items-center justify-center py-6">
        <img src="../assets/images/dursia3.png" alt="dursia screenshot" class="max-h-[80vh] w-auto object-contain" />
      </section>

      <section class="snap-start snap-always h-[100dvh] w-full flex items-center justify-center py-6">
        <img src="../assets/images/dursia4.png" alt="dursia screenshot" class="max-h-[80vh] w-auto object-contain" />
      </section>

      <section class="snap-start snap-always h-[100dvh] w-full flex items-center justify-center py-6">
        <img src="../assets/images/dursia5.png" alt="dursia screenshot" class="max-h-[80vh] w-auto object-contain" />
      </section>

      <section class="snap-start snap-always h-[100dvh] w-full flex items-center justify-center py-6">
        <img src="../assets/images/dursia6.png" alt="dursia screenshot" class="max-h-[80vh] w-auto object-contain" />
      </section>

      <section class="snap-start snap-always h-[100dvh] w-full flex items-center justify-center py-6">
        <img src="../assets/images/dursia7.png" alt="dursia screenshot" class="max-h-[80vh] w-auto object-contain" />
      </section>

      <section class="snap-start snap-always h-[100dvh] w-full flex items-center justify-center py-6">
        <img src="../assets/images/dursia8.png" alt="dursia screenshot" class="max-h-[80vh] w-auto object-contain" />
      </section>

      <section class="snap-start snap-always h-[100dvh] w-full flex items-center justify-center py-6">
        <img src="../assets/images/dursia9.png" alt="dursia screenshot" class="max-h-[80vh] w-auto object-contain" />
      </section>

      <section class="snap-start snap-always h-[100dvh] w-full flex items-center justify-center py-6">
        <img src="../assets/images/dursia10.png" alt="dursia screenshot" class="max-h-[80vh] w-auto object-contain" />
      </section>

      <section class="snap-start snap-always h-[100dvh] w-full flex items-center justify-center py-6">
        <img src="../assets/images/dursia11.png" alt="dursia screenshot" class="max-h-[80vh] w-auto object-contain" />
      </section>

      <!-- Logo -->
      <section class="snap-start snap-always h-[100dvh] w-full flex items-center justify-center py-6">
        <a href="/" class="max-w-[70%] block">
          <Image class="max-h-[50vh] object-contain" src={dursiaLogo} alt="dursia logo" />
        </a>
      </section>

      <!-- Poster -->
      <section class="snap-start snap-always h-[100dvh] w-full flex items-center justify-center py-6">
        <img src="../assets/images/DURSIA-art-nouveau-poster.jpeg" alt="DURSIA art nouveau poster" class="max-h-[80vh] w-auto object-contain rounded-lg shadow-xl" />
      </section>
    </div>

    <!-- DESKTOP VIEW: Rækker af 3 billeder -->
    <div class="hidden md:block max-w-7xl mx-auto">
      <!-- Row 1 -->
      <section class="snap-start snap-always h-[100dvh] flex items-center justify-center py-6">
        <div class="grid grid-cols-3 gap-8 w-full">
          <img src="../assets/images/dursia1.png" alt="dursia screenshot" class="mx-auto max-h-[75vh] object-contain" />
          <img src="../assets/images/dursia2.png" alt="dursia screenshot" class="mx-auto max-h-[75vh] object-contain" />
          <img src="../assets/images/dursia3.png" alt="dursia screenshot" class="mx-auto max-h-[75vh] object-contain" />
        </div>
      </section>

      <!-- Row 2 -->
      <section class="snap-start snap-always h-[100dvh] flex items-center justify-center py-6">
        <div class="grid grid-cols-3 gap-8 w-full">
          <img src="../assets/images/dursia4.png" alt="dursia screenshot" class="mx-auto max-h-[75vh] object-contain" />
          <img src="../assets/images/dursia5.png" alt="dursia screenshot" class="mx-auto max-h-[75vh] object-contain" />
          <img src="../assets/images/dursia6.png" alt="dursia screenshot" class="mx-auto max-h-[75vh] object-contain" />
        </div>
      </section>

      <!-- Row 3 -->
      <section class="snap-start snap-always h-[100dvh] flex items-center justify-center py-6">
        <div class="grid grid-cols-3 gap-8 w-full">
          <img src="../assets/images/dursia7.png" alt="dursia screenshot" class="mx-auto max-h-[75vh] object-contain" />
          <img src="../assets/images/dursia8.png" alt="dursia screenshot" class="mx-auto max-h-[75vh] object-contain" />
          <img src="../assets/images/dursia9.png" alt="dursia screenshot" class="mx-auto max-h-[75vh] object-contain" />
        </div>
      </section>

      <!-- Row 4 -->
      <section class="snap-start snap-always h-[100dvh] flex items-center justify-center py-6">
        <div class="flex items-center justify-center gap-12 w-full">
          <img src="../assets/images/dursia10.png" alt="dursia screenshot" class="max-h-[75vh] object-contain max-w-[28%]" />
          <img src="../assets/images/dursia11.png" alt="dursia screenshot" class="max-h-[75vh] object-contain max-w-[28%]" />
        </div>
      </section>

      <!-- Logo section -->
      <section class="snap-start snap-always h-[100dvh] flex items-center justify-center py-6">
        <a href="/" class="max-w-[40%] block">
          <Image class="object-contain" src={dursiaLogo} alt="dursia logo" />
        </a>
      </section>

      <!-- Poster section -->
      <section class="snap-start snap-always h-[100dvh] flex items-center justify-center py-6">
        <img src="../assets/images/DURSIA-art-nouveau-poster.jpeg" alt="DURSIA art nouveau poster" class="max-h-[75vh] object-contain rounded-lg shadow-xl" />
      </section>
    </div>

    <!-- Tilbage-knap -->
    <IconButton href="/">
      <img src="/assets/icons/arrow-back.svg" alt="back arrow" class="fixed bottom-10 right-4 md:bottom-14 md:right-8 z-50 w-14 h-14 rounded-full bg-black/40 p-2 backdrop-blur-sm hover:bg-black/60 transition" />
    </IconButton>
  </main>
</MainLayout>

<!-- SCRIPT DER SIKRER TASTENTRYK PÅ PILETASTER OG AUTO-FOKUS -->
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const container = document.getElementById("feature-scroll-container");
    if (!container) return;

    // Sæt fokus på containeren med det samme så piletaster virker med det samme
    container.focus();

    // Håndter piletaster direkte via JS for 100% stabilitet
    window.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown" || e.key === "PageDown") {
        e.preventDefault();
        container.scrollBy({ top: container.clientHeight, behavior: "smooth" });
      } else if (e.key === "ArrowUp" || e.key === "PageUp") {
        e.preventDefault();
        container.scrollBy({ top: -container.clientHeight, behavior: "smooth" });
      }
    });
  });
</script>
