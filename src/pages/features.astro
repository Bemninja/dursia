---
import MainLayout from "../layouts/MainLayout.astro";
import { Image } from "astro:assets";
import dursiaLogo from "../../src/images/dursialogo.png";
import IconButton from "../components/IconButton.astro";
---

<MainLayout title="DURSIA - Features">
  <!-- Siden sættes til h-screen og overflow-y-scroll med snap-y -->
  <main class="w-full h-screen overflow-y-scroll snap-y snap-mandatory scroll-smooth px-4 md:px-12 lg:px-24">
    <!-- MOBIL: Enkelt-billeder med snap-center -->
    <div class="md:hidden flex flex-col items-center gap-8 py-8">
      <img src="../assets/images/dursia1.png" alt="dursia screenshot" class="snap-center w-auto h-[85vh] object-contain my-4" />
      <img src="../assets/images/dursia2.png" alt="dursia screenshot" class="snap-center w-auto h-[85vh] object-contain my-4" />
      <img src="../assets/images/dursia3.png" alt="dursia screenshot" class="snap-center w-auto h-[85vh] object-contain my-4" />
      <img src="../assets/images/dursia4.png" alt="dursia screenshot" class="snap-center w-auto h-[85vh] object-contain my-4" />
      <img src="../assets/images/dursia5.png" alt="dursia screenshot" class="snap-center w-auto h-[85vh] object-contain my-4" />
      <img src="../assets/images/dursia6.png" alt="dursia screenshot" class="snap-center w-auto h-[85vh] object-contain my-4" />
      <img src="../assets/images/dursia7.png" alt="dursia screenshot" class="snap-center w-auto h-[85vh] object-contain my-4" />
      <img src="../assets/images/dursia8.png" alt="dursia screenshot" class="snap-center w-auto h-[85vh] object-contain my-4" />
      <img src="../assets/images/dursia9.png" alt="dursia screenshot" class="snap-center w-auto h-[85vh] object-contain my-4" />
      <img src="../assets/images/dursia10.png" alt="dursia screenshot" class="snap-center w-auto h-[85vh] object-contain my-4" />
      <img src="../assets/images/dursia11.png" alt="dursia screenshot" class="snap-center w-auto h-[85vh] object-contain my-4" />

      <a href="/" class="snap-center my-8 max-w-[70%] flex justify-center">
        <Image class="max-h-[50vh] object-contain" src={dursiaLogo} alt="dursia logo" />
      </a>

      <img src="../assets/images/DURSIA-art-nouveau-poster.jpeg" alt="DURSIA art nouveau poster" class="snap-center w-auto h-[85vh] object-contain my-4" />
    </div>

    <!-- DESKTOP: Rækker med 3 billeder der snapper (snap-start / snap-center) -->
    <div class="hidden md:block max-w-7xl mx-auto">
      <!-- Row 1 -->
      <div class="snap-start min-h-screen flex items-center justify-center py-10">
        <div class="grid grid-cols-3 gap-8 w-full">
          <img src="../assets/images/dursia1.png" alt="dursia screenshot" class="mx-auto h-[75vh] object-contain" />
          <img src="../assets/images/dursia2.png" alt="dursia screenshot" class="mx-auto h-[75vh] object-contain" />
          <img src="../assets/images/dursia3.png" alt="dursia screenshot" class="mx-auto h-[75vh] object-contain" />
        </div>
      </div>

      <!-- Row 2 -->
      <div class="snap-start min-h-screen flex items-center justify-center py-10">
        <div class="grid grid-cols-3 gap-8 w-full">
          <img src="../assets/images/dursia4.png" alt="dursia screenshot" class="mx-auto h-[75vh] object-contain" />
          <img src="../assets/images/dursia5.png" alt="dursia screenshot" class="mx-auto h-[75vh] object-contain" />
          <img src="../assets/images/dursia6.png" alt="dursia screenshot" class="mx-auto h-[75vh] object-contain" />
        </div>
      </div>

      <!-- Row 3 -->
      <div class="snap-start min-h-screen flex items-center justify-center py-10">
        <div class="grid grid-cols-3 gap-8 w-full">
          <img src="../assets/images/dursia7.png" alt="dursia screenshot" class="mx-auto h-[75vh] object-contain" />
          <img src="../assets/images/dursia8.png" alt="dursia screenshot" class="mx-auto h-[75vh] object-contain" />
          <img src="../assets/images/dursia9.png" alt="dursia screenshot" class="mx-auto h-[75vh] object-contain" />
        </div>
      </div>

      <!-- Row 4 -->
      <div class="snap-start min-h-screen flex items-center justify-center py-10">
        <div class="flex items-center justify-center gap-12 w-full">
          <img src="../assets/images/dursia10.png" alt="dursia screenshot" class="h-[75vh] object-contain max-w-[28%]" />
          <img src="../assets/images/dursia11.png" alt="dursia screenshot" class="h-[75vh] object-contain max-w-[28%]" />
        </div>
      </div>

      <!-- Logo section -->
      <div class="snap-start min-h-screen flex items-center justify-center py-10">
        <a href="/" class="max-w-[40%] block">
          <Image class="object-contain" src={dursiaLogo} alt="dursia logo" />
        </a>
      </div>

      <!-- Poster section -->
      <div class="snap-start min-h-screen flex items-center justify-center py-10">
        <img src="../assets/images/DURSIA-art-nouveau-poster.jpeg" alt="DURSIA art nouveau poster" class="h-[75vh] object-contain" />
      </div>
    </div>

    <!-- Tilbage-knap -->
    <IconButton href="/">
      <img src="../assets/icons/arrow-back.svg" alt="back arrow" class="fixed bottom-4 right-4 z-50 w-14 h-14 md:bottom-8 md:right-8 rounded-full bg-black/30 p-2 backdrop-blur-sm hover:bg-black/50 transition" />
    </IconButton>
  </main>
</MainLayout>
