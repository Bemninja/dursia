---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="DURSIA – A dating app for introverts">
  <!-- FAST BAGGRUND SOM ALDRIG SCROLLER ELLER FLYTTER SIG -->
  <div class="fixed inset-0 z-0 pointer-events-none overflow-hidden">
    <div class="absolute inset-0 flex items-center justify-center">
      <img src="/dursia-logo.png" alt="DURSIA" class="w-[75vw] lg:w-[50vw] max-w-[720px] opacity-20" />
    </div>
  </div>

  <!-- MAIN SCROLLABLE CONTENT -->
  <main class="relative z-10 w-full min-h-screen lg:h-screen lg:overflow-hidden flex flex-col justify-between py-6 lg:py-0">
    <!-- TOP TEXT BOXES -->
    <div class="relative lg:absolute lg:top-6 left-0 right-0 z-30 flex flex-col lg:flex-row justify-center items-center gap-3 lg:gap-6 px-4 lg:px-8">
      <!-- Small left (DURSIA) -->
      <div
        class="order-1 lg:order-1 rounded-2xl bg-gradient-to-r from-blue-800/60 to-blue-600/30 backdrop-blur-md px-4 lg:px-6 py-3 text-white shadow-lg w-full max-w-[92vw] lg:w-[250px] min-h-[64px] lg:min-h-[68px] flex flex-col justify-center text-center border border-white/20 transition-all duration-300 ease-out origin-center hover:scale-105 hover:shadow-[0_16px_32px_rgba(0,0,0,0.5)] will-change-transform"
      >
        <p class="font-semibold text-base lg:text-sm leading-tight">DURSIA</p>
        <p class="text-white/90 text-sm lg:text-sm leading-normal">A dating app for introverts.</p>
      </div>

      <!-- Large center (Forklaring) -->
      <div
        id="expandable-text-box"
        class="order-2 lg:order-2 rounded-2xl bg-gradient-to-r from-blue-800/60 to-blue-600/30 backdrop-blur-md px-4 lg:px-6 pt-3.5 pb-7 lg:py-3.5 text-white text-sm lg:text-base shadow-lg w-full max-w-[92vw] lg:max-w-xl text-center leading-relaxed lg:leading-snug border border-white/20 cursor-pointer lg:cursor-default select-none relative transition-all duration-300 ease-out origin-center hover:scale-105 hover:shadow-[0_16px_32px_rgba(0,0,0,0.5)] will-change-transform"
      >
        <p id="text-content" class="mobile-collapsed transition-all duration-300 text-pretty w-full">
          A dating app that shows you the strangers, you passed, reconnects you and reduces the nervousness and awkwardness, when you meet again. You safely get to know each other through treasure hunts IRL, before meeting face&nbsp;to&nbsp;face.<br
          />
          Passive matches are transformed into AR&nbspadventures.
        </p>

        <div id="expand-arrow-wrapper" class="absolute bottom-1.5 left-0 right-0 flex lg:hidden justify-center items-center pointer-events-none">
          <svg id="expand-arrow" class="w-5 h-5 text-white/90 transform transition-transform duration-300 ease-in-out animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path>
          </svg>
        </div>
      </div>

      <!-- Small right (Get out...) -->
      <div
        class="order-3 lg:order-3 rounded-2xl bg-gradient-to-r from-blue-800/60 to-blue-600/30 backdrop-blur-md px-4 lg:px-6 py-3 text-white text-sm lg:text-sm shadow-lg w-full max-w-[92vw] lg:w-[250px] min-h-[64px] lg:min-h-[68px] flex flex-col justify-center text-center border border-white/20 transition-all duration-300 ease-out origin-center hover:scale-105 hover:shadow-[0_16px_32px_rgba(0,0,0,0.5)] will-change-transform"
      >
        <p class="leading-snug">Get out · Make routes</p>
        <p class="leading-snug">Cross paths · Find treasures</p>
      </div>
    </div>

    <!-- CENTER VIDEO (STRIKT BEGRÆNSET TIL MAX-W-XL OG BREDDEN AF DEN STORE TEKSTBOKS) -->
    <div class="relative lg:absolute lg:top-1/2 lg:left-1/2 lg:-translate-x-1/2 lg:-translate-y-1/2 z-20 my-6 lg:my-0 flex justify-center items-center w-full px-4">
      <div class="animate-video-swing flex justify-center w-full max-w-[92vw] lg:max-w-xl">
        <div class="w-full rounded-xl transition-all duration-300 ease-out origin-center hover:scale-105 hover:shadow-[0_20px_40px_rgba(0,0,0,0.6)] will-change-transform cursor-pointer">
          <video class="video-item pointer-events-none select-none w-full" src="/assets/video/dursia-8-shy-videos.mp4" muted loop playsinline autoplay oncontextmenu="return false;"></video>
        </div>
      </div>
    </div>

    <!-- BOTTOM BUTTONS -->
    <div class="relative mt-auto pb-6 lg:pb-0 lg:absolute lg:bottom-10 left-0 right-0 z-50 flex flex-col sm:flex-row justify-center items-center gap-3 lg:gap-8 xl:gap-14 px-4">
      <a
        href="/demo"
        class="group relative inline-flex items-center justify-center rounded-full bg-gradient-to-r from-blue-800/70 via-blue-700/25 to-cyan-600/20 hover:from-blue-800/80 hover:via-blue-600/70 hover:to-cyan-500/60 active:from-blue-900/90 active:to-cyan-500/80 backdrop-blur-md border-none text-white font-bold text-xs sm:text-sm tracking-wider uppercase w-40 sm:w-44 lg:w-48 h-11 px-5 transition-all duration-300 hover:scale-105 active:scale-95 shadow-none hover:shadow-[0_12px_25px_rgba(0,0,0,0.35),0_0_20px_rgba(6,182,212,0.4)]"
      >
        <span class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 flex items-center justify-center transition-transform duration-300 group-hover:scale-125 group-hover:translate-x-1">
          <span class="text-xs leading-none text-white">▶</span>
        </span>
        <span class="w-full text-center pl-4 drop-shadow">Demo</span>
      </a>

      <a
        href="/features"
        class="group relative inline-flex items-center justify-center rounded-full bg-gradient-to-r from-blue-800/70 via-blue-700/25 to-cyan-600/20 hover:from-blue-800/80 hover:via-blue-600/70 hover:to-cyan-500/60 active:from-blue-900/90 active:to-cyan-500/80 backdrop-blur-md border-none text-white font-bold text-xs sm:text-sm tracking-wider uppercase w-40 sm:w-44 lg:w-48 h-11 px-5 transition-all duration-300 hover:scale-105 active:scale-95 shadow-none hover:shadow-[0_12px_25px_rgba(0,0,0,0.35),0_0_20px_rgba(6,182,212,0.4)]"
      >
        <span class="absolute left-4 top-1/2 -translate-y-[calc(50%+2px)] w-5 h-5 flex items-center justify-center transition-transform duration-300 group-hover:-rotate-12 group-hover:scale-110">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h6v6H4V6zm10 0h6v6h-6V6zM4 16h6v6H4v-6zm10 0h6v6h-6v-6z"></path>
          </svg>
        </span>
        <span class="w-full text-center pl-4 drop-shadow">Features</span>
      </a>

      <button
        id="open-signup"
        class="group relative inline-flex items-center justify-center rounded-full bg-gradient-to-r from-red-800/80 via-rose-500/45 to-rose-500/30 hover:from-red-800/80 hover:via-rose-600/70 hover:to-rose-400/60 active:from-red-900/90 active:to-rose-500/80 backdrop-blur-md border-none text-white font-bold text-xs sm:text-sm tracking-wider uppercase w-40 sm:w-44 lg:w-48 h-11 px-5 transition-all duration-300 hover:scale-105 active:scale-95 cursor-pointer shadow-none hover:shadow-[0_12px_25px_rgba(0,0,0,0.35),0_0_20px_rgba(244,63,94,0.4)]"
      >
        <span class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 flex items-center justify-center transition-transform duration-300 group-hover:-rotate-12 group-hover:scale-110">
          <img src="/assets/icons/pencil-icon-white.png" alt="Join" class="w-4 h-4 brightness-0 invert object-contain" />
        </span>
        <span class="w-full text-center pl-4 drop-shadow">Join?</span>
      </button>
    </div>
  </main>

  <!-- Join Modal -->
  <div id="signup-modal" class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/60 backdrop-blur-sm p-4 sm:p-6 overflow-y-auto no-scrollbar transition-all duration-[8000ms] ease-in-out opacity-100">
    <div class="bg-gradient-to-b from-blue-50 via-slate-100 to-blue-200/90 rounded-2xl p-5 sm:p-6 lg:p-8 w-full max-w-md my-auto shadow-2xl relative border border-white/60 shrink-0">
      <button id="close-signup" class="absolute top-3 right-3 sm:top-4 sm:right-4 z-20 text-gray-400 hover:text-gray-700 text-xl leading-none p-1"> × </button>
      <img src="/dursia-logo.png" alt="" class="absolute inset-0 m-auto w-80 opacity-10 pointer-events-none select-none" />

      <div class="relative z-10">
        <h2 class="text-lg sm:text-xl lg:text-2xl font-semibold text-gray-900 mb-0.5 text-center">Join DURSIA?</h2>
        <p class="text-gray-500 text-xs sm:text-sm mb-3 sm:mb-5 text-center">Leave your details below:</p>

        <form id="signup-form" action="https://formspree.io/f/xvkpgkra" method="POST" novalidate class="space-y-2.5 sm:space-y-4">
          <div>
            <label class="block text-xs lg:text-sm text-gray-600 mb-0.5 sm:mb-1">Name</label>
            <input
              type="text"
              name="name"
              required
              title="Please fill out this field."
              class="w-full rounded-xl sm:rounded-2xl border border-gray-300/80 bg-white/80 px-3 py-1.5 sm:py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
              placeholder="Your name"
            />
          </div>

          <!-- Background -->
          <div>
            <label class="block text-xs lg:text-sm text-gray-600 mb-1">Background</label>
            <div class="flex flex-wrap items-center gap-x-4 gap-y-1.5 text-xs lg:text-sm text-gray-700">
              <label class="inline-flex items-center gap-1.5 cursor-pointer">
                <input type="radio" name="background" value="Programmer" required title="Please select one of these options." class="text-blue-600 focus:ring-blue-500" />
                <span>Programmer</span>
              </label>
              <label class="inline-flex items-center gap-1.5 cursor-pointer">
                <input type="radio" name="background" value="Investor" required title="Please select one of these options." class="text-blue-600 focus:ring-blue-500" />
                <span>Investor</span>
              </label>
              <label class="inline-flex items-center gap-1.5 cursor-pointer">
                <input type="radio" name="background" value="Other" required title="Please select one of these options." class="text-blue-600 focus:ring-blue-500" />
                <span>Other</span>
              </label>
            </div>
          </div>

          <div>
            <label class="block text-xs lg:text-sm text-gray-600 mb-0.5 sm:mb-1">Comments</label>
            <textarea
              name="comments"
              rows="2"
              required
              minlength="15"
              title="Please write at least 15 characters - e.g. website or portfolio link."
              class="w-full rounded-xl sm:rounded-2xl border border-gray-300/80 bg-white/80 px-3 py-1.5 sm:py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 resize-none"
              placeholder="Your skill level / link to work / comments"></textarea>
          </div>

          <div class="grid grid-cols-3 gap-2.5 sm:gap-3">
            <div class="col-span-1">
              <label class="block text-xs lg:text-sm text-gray-600 mb-0.5 sm:mb-1">Phone</label>
              <input type="tel" name="phone" class="w-full rounded-xl sm:rounded-2xl border border-gray-300/80 bg-white/80 px-3 py-1.5 sm:py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Your phone" />
            </div>

            <div class="col-span-2">
              <label class="block text-xs lg:text-sm text-gray-600 mb-0.5 sm:mb-1">Email</label>
              <input
                type="email"
                name="email"
                required
                title="Please enter a valid email address."
                class="w-full rounded-xl sm:rounded-2xl border border-gray-300/80 bg-white/80 px-3 py-1.5 sm:py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                placeholder="Your email"
              />
            </div>
          </div>

          <button type="submit" class="w-full mt-1.5 sm:mt-2 rounded-xl sm:rounded-2xl bg-gradient-to-r from-red-600 to-rose-500 hover:from-red-500 hover:to-rose-400 text-white font-medium py-2 sm:py-2.5 transition text-sm"> Send </button>
        </form>
      </div>
    </div>
  </div>

  <!-- Thank You Message Window -->
  <div id="thank-you-message" class="fixed inset-0 z-[110] hidden items-center justify-center p-4 transition-opacity duration-500 opacity-0 pointer-events-none">
    <div class="bg-white/90 backdrop-blur-md rounded-2xl p-6 lg:p-8 max-w-sm text-center shadow-2xl border border-white/60">
      <div class="w-12 h-12 bg-green-100 text-green-600 rounded-full flex items-center justify-center mx-auto mb-3 text-xl font-bold">✓</div>
      <h3 class="text-lg lg:text-xl font-semibold text-gray-900 mb-1">Thank you!</h3>
      <p class="text-gray-600 text-xs lg:text-sm">Your details have been sent.</p>
    </div>
  </div>
</MainLayout>

<style>
  /* Skjul scrollbar for Chrome, Safari og Opera */
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  /* Skjul scrollbar for IE, Edge og Firefox */
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  @media (max-width: 1023px) and (orientation: portrait) {
    #text-content.mobile-collapsed {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
  }

  @media (min-width: 1024px) {
    #text-content {
      display: block !important;
      overflow: visible !important;
      -webkit-line-clamp: none !important;
      height: auto !important;
    }

    #expand-arrow-wrapper {
      display: none !important;
    }
  }

  .video-item {
    width: 100% !important;
    max-width: 100% !important;
    height: auto !important;
    border-radius: 14px;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.45);
    display: block;
    object-fit: cover;
  }

  @media (orientation: landscape) and (max-width: 1023px) {
    main {
      height: auto !important;
      min-height: 100vh !important;
      overflow-y: auto !important;
      padding-top: 1.5rem !important;
      padding-bottom: 5rem !important;
      display: flex !important;
      flex-direction: column !important;
      align-items: center !important;
      justify-content: flex-start !important;
      gap: 1.5rem !important;
    }

    main > div:first-child {
      flex-direction: row !important;
      flex-wrap: nowrap !important;
      justify-content: center !important;
      align-items: stretch !important;
      gap: 0.75rem !important;
      padding-left: 1rem !important;
      padding-right: 1rem !important;
    }

    main > div:first-child > div:first-child,
    main > div:first-child > div:last-child {
      width: 22% !important;
      max-width: 180px !important;
      min-width: 140px !important;
      font-size: 0.75rem !important;
      padding: 0.5rem 0.75rem !important;
    }

    main > div:first-child > div:nth-child(2) {
      width: 52% !important;
      max-width: 480px !important;
      font-size: 0.75rem !important;
      line-height: 1.25 !important;
      padding: 0.5rem 0.85rem !important;
    }

    /* Tving videoen i landscape til at matche den midterste tekstboks' bredde (52% / max 480px) */
    main > div:nth-child(2) > div {
      width: 52% !important;
      max-width: 480px !important;
    }

    #text-content {
      display: block !important;
      overflow: visible !important;
      -webkit-line-clamp: none !important;
    }

    #expand-arrow-wrapper {
      display: none !important;
    }

    a[href="/demo"] {
      display: inline-flex !important;
    }

    main > div:has(a[href="/demo"]) {
      flex-direction: row !important;
      flex-wrap: nowrap !important;
      justify-content: center !important;
      align-items: center !important;
      gap: 1rem !important;
      width: 100% !important;
      margin-top: 0.5rem !important;
    }

    main > div:has(a[href="/demo"]) a,
    main > div:has(a[href="/demo"]) button {
      width: 11rem !important;
      height: 2.75rem !important;
      font-size: 0.75rem !important;
    }
  }
</style>

<script>
  const setupIndex = () => {
    const form = document.getElementById("signup-form");
    const signupModal = document.getElementById("signup-modal");
    const modalInner = signupModal ? signupModal.firstElementChild : null;
    const thankYouMsg = document.getElementById("thank-you-message");

    const openModal = () => {
      if (!signupModal) return;
      signupModal.classList.remove("opacity-0", "pointer-events-none");
      signupModal.classList.add("opacity-100");
      if (modalInner) modalInner.style.display = "block";
      signupModal.classList.remove("hidden");
      signupModal.classList.add("flex");
    };

    const closeModal = () => {
      if (!signupModal) return;
      signupModal.classList.remove("flex");
      signupModal.classList.add("hidden");
    };

    if (form) {
      form.addEventListener("submit", async (e) => {
        e.preventDefault();

        let firstInvalid = null;

        // 1. Validering: Name
        const nameInput = form.querySelector('input[name="name"]');
        if (nameInput && !nameInput.value.trim()) {
          nameInput.setCustomValidity("Please fill out this field.");
          if (!firstInvalid) firstInvalid = nameInput;
        } else if (nameInput) {
          nameInput.setCustomValidity("");
        }

        // 2. Validering: Background (Radio buttons)
        const backgroundRadios = form.querySelectorAll('input[name="background"]');
        const isRadioChecked = Array.from(backgroundRadios).some((r) => r.checked);
        if (!isRadioChecked && backgroundRadios.length > 0) {
          backgroundRadios[0].setCustomValidity("Please select one of these options.");
          if (!firstInvalid) firstInvalid = backgroundRadios[0];
        } else {
          backgroundRadios.forEach((r) => r.setCustomValidity(""));
        }

        // 3. Validering: Comments (Mindst 15 tegn)
        const commentsInput = form.querySelector('textarea[name="comments"]');
        if (commentsInput) {
          const commentVal = commentsInput.value.trim();
          if (!commentVal) {
            commentsInput.setCustomValidity("Please fill out this field.");
            if (!firstInvalid) firstInvalid = commentsInput;
          } else if (commentVal.length < 15) {
            commentsInput.setCustomValidity("Please enter at least 15 characters.");
            if (!firstInvalid) firstInvalid = commentsInput;
          } else {
            commentsInput.setCustomValidity("");
          }
        }

        // 4. Validering: Email
        const emailInput = form.querySelector('input[name="email"]');
        if (emailInput) {
          const emailVal = emailInput.value.trim();
          const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
          if (!emailVal) {
            emailInput.setCustomValidity("Please fill out this field.");
            if (!firstInvalid) firstInvalid = emailInput;
          } else if (!emailPattern.test(emailVal)) {
            emailInput.setCustomValidity("Please enter a valid email address.");
            if (!firstInvalid) firstInvalid = emailInput;
          } else {
            emailInput.setCustomValidity("");
          }
        }

        // Stop formularen hvis der er valideringsfejl
        if (firstInvalid) {
          firstInvalid.reportValidity();
          return;
        }

        // Send data i baggrunden via Fetch
        const formData = new FormData(form);
        const submitBtn = form.querySelector('button[type="submit"]');
        if (submitBtn) submitBtn.disabled = true;

        try {
          const response = await fetch(form.action, {
            method: "POST",
            body: formData,
            headers: { Accept: "application/json" },
          });

          if (response.ok) {
            // Skjul formularkort og nulstil felter
            if (modalInner) modalInner.style.display = "none";
            form.reset();

            // Vis Takke-vinduet
            if (thankYouMsg) {
              thankYouMsg.classList.remove("hidden");
              thankYouMsg.classList.add("flex");
              setTimeout(() => {
                thankYouMsg.classList.remove("opacity-0");
                thankYouMsg.classList.add("opacity-100");
              }, 10);
            }

            // Start glidende fade af baggrunden
            if (signupModal) {
              signupModal.classList.remove("opacity-100");
              signupModal.classList.add("opacity-0", "pointer-events-none");
            }

            // Fade takkeskiltet ud efter 2,5 sekunder
            setTimeout(() => {
              if (thankYouMsg) {
                thankYouMsg.classList.remove("opacity-100");
                thankYouMsg.classList.add("opacity-0");
              }
            }, 2500);

            // Opryd og luk alt efter 8 sekunder
            setTimeout(() => {
              if (thankYouMsg) {
                thankYouMsg.classList.remove("flex");
                thankYouMsg.classList.add("hidden");
              }
              closeModal();
            }, 8000);
          } else {
            alert("Oops! There was a problem submitting your form. Please try again.");
          }
        } catch (error) {
          alert("Oops! There was a network error. Please check your connection.");
        } finally {
          if (submitBtn) submitBtn.disabled = false;
        }
      });

      // Nulstil valideringsbeskeder ved indtastning
      form.querySelectorAll("input, textarea").forEach((input) => {
        input.addEventListener("input", () => input.setCustomValidity(""));
        input.addEventListener("change", () => input.setCustomValidity(""));
      });
    }

    // Video autoplay
    const video = document.querySelector("video");
    if (video) {
      video.muted = true;
      video.playsInline = true;
      video.play().catch(() => {
        document.body.addEventListener("click", () => video.play(), { once: true });
      });
    }

    // Expandable text box (mobil)
    const textBox = document.getElementById("expandable-text-box");
    const textContent = document.getElementById("text-content");
    const expandArrowWrapper = document.getElementById("expand-arrow-wrapper");

    const updateArrowVisibility = () => {
      if (!textContent || !expandArrowWrapper) return;

      const isMobilePortrait = window.innerWidth < 1024 && window.innerHeight > window.innerWidth;
      const isCollapsed = textContent.classList.contains("mobile-collapsed");

      if (isMobilePortrait && isCollapsed) {
        expandArrowWrapper.classList.remove("hidden");
        expandArrowWrapper.classList.add("flex");
      } else {
        expandArrowWrapper.classList.add("hidden");
        expandArrowWrapper.classList.remove("flex");
      }
    };

    if (textBox && textContent) {
      updateArrowVisibility();

      textBox.addEventListener("click", () => {
        if (window.innerWidth < 1024) {
          textContent.classList.toggle("mobile-collapsed");
          updateArrowVisibility();
        }
      });

      window.addEventListener("resize", updateArrowVisibility);
    }

    // Modal Control Events
    const openSignupBtn = document.getElementById("open-signup");
    const closeSignupBtn = document.getElementById("close-signup");

    if (openSignupBtn) openSignupBtn.addEventListener("click", openModal);
    if (closeSignupBtn) closeSignupBtn.addEventListener("click", closeModal);

    if (signupModal) {
      signupModal.addEventListener("click", (e) => {
        if (e.target === signupModal) closeModal();
      });
    }
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupIndex);
  } else {
    setupIndex();
  }
  document.addEventListener("astro:page-load", setupIndex);
</script>
