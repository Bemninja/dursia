---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="DURSIA – A dating app for introverts">
  <!-- Main container -->
  <main class="relative w-full min-h-screen lg:h-screen lg:overflow-hidden flex flex-col justify-between py-6 lg:py-0">
    <!-- TOP TEXT BOXES -->
    <div class="relative lg:absolute lg:top-6 left-0 right-0 z-30 flex flex-col lg:flex-row justify-center items-center gap-3 lg:gap-6 px-4 lg:px-8">
      <!-- Small left (DURSIA) -->
      <div
        class="order-1 lg:order-1 rounded-2xl bg-gradient-to-r from-blue-800/40 to-blue-600/40 backdrop-blur-md px-4 lg:px-6 py-3 text-white shadow-lg w-full max-w-[92vw] lg:w-[250px] min-h-[64px] lg:min-h-[68px] flex flex-col justify-center text-center border border-white/20"
      >
        <p class="font-semibold text-base lg:text-sm leading-tight">DURSIA</p>
        <p class="text-white/90 text-sm lg:text-sm leading-normal">A dating app for introverts.</p>
      </div>

      <!-- Large center (Forklaring) -->
      <div
        id="expandable-text-box"
        class="order-2 lg:order-2 rounded-2xl bg-gradient-to-r from-blue-800/40 to-blue-600/40 backdrop-blur-md px-4 lg:px-6 pt-3.5 pb-7 lg:py-3.5 text-white text-sm lg:text-base shadow-lg w-full max-w-[92vw] lg:max-w-xl text-center leading-relaxed lg:leading-snug border border-white/20 cursor-pointer lg:cursor-default select-none relative transition-all duration-300 ease-in-out"
      >
        <!-- Teksten har INGEN line-clamp i HTML. CSS styrer mobil-afskæringen nedenfor! -->
        <p id="text-content" class="transition-all duration-300">
          A dating app that shows you the strangers, you passed, reconnects you and reduces the nervousness, when you meet again. You get to know each other through treasure hunts, before meeting face to face. <br /> Passive matches are transformed into
          AR&nbsp;adventures.
        </p>

        <!-- Pilen visning: Skjules automatisk helt på lg skærme -->
        <div id="expand-arrow-wrapper" class="absolute bottom-1.5 left-0 right-0 flex lg:hidden justify-center items-center pointer-events-none">
          <svg id="expand-arrow" class="w-5 h-5 text-white/90 transform transition-transform duration-300 ease-in-out animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path>
          </svg>
        </div>
      </div>

      <!-- Small right (Get out...) -->
      <div
        class="order-3 lg:order-3 rounded-2xl bg-gradient-to-r from-blue-800/40 to-blue-600/40 backdrop-blur-md px-4 lg:px-6 py-3 text-white text-sm lg:text-sm shadow-lg w-full max-w-[92vw] lg:w-[250px] min-h-[64px] lg:min-h-[68px] flex flex-col justify-center text-center border border-white/20"
      >
        <p class="leading-snug">Get out · Make routes</p>
        <p class="leading-snug">Cross paths · Find treasures</p>
      </div>
    </div>

    <!-- CENTER VIDEO -->
    <div class="relative lg:absolute lg:top-1/2 lg:left-1/2 lg:-translate-x-1/2 lg:-translate-y-1/2 z-20 my-6 lg:my-0 flex justify-center items-center w-full">
      <div class="animate-video-swing flex justify-center">
        <video class="video-item" src="/assets/video/dursia-6-shy-videos.mp4" muted loop playsinline autoplay></video>
      </div>
    </div>

    <!-- Central logo watermark -->
    <div class="fixed inset-0 z-10 flex items-center justify-center pointer-events-none">
      <img src="/dursia-logo.png" alt="DURSIA" class="w-[75vw] lg:w-[50vw] max-w-[720px] opacity-20" />
    </div>

    <!-- BOTTOM BUTTONS -->
    <div class="relative mt-auto pb-6 lg:pb-0 lg:absolute lg:bottom-10 left-0 right-0 z-50 flex flex-col lg:flex-row justify-center items-center gap-3 lg:gap-8 xl:gap-14 px-4">
      <!-- Demo button -->
      <a
        href="/demo"
        class="glass-card order-1 lg:order-1 relative flex items-center rounded-full bg-gradient-to-r from-blue-900/70 via-blue-700/50 to-cyan-600/40 hover:from-blue-800/90 hover:to-cyan-500/60 backdrop-blur-xl border border-white/20 hover:border-white/40 shadow-[inset_0_1px_1px_rgba(255,255,255,0.3)] shadow-xl text-white w-40 lg:w-auto lg:min-w-[165px] h-11 px-5 transition-all duration-300 shrink-0 hover:scale-105 active:scale-95"
      >
        <!-- Fast centreret ikon til venstre -->
        <span class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 flex items-center justify-center pointer-events-none">
          <span class="text-xs leading-none">▶</span>
        </span>
        <!-- Tekst -->
        <span class="w-full text-center text-sm font-medium pl-4">Demo</span>
      </a>

      <!-- Features button -->
      <a
        href="/features"
        class="glass-card order-2 lg:order-3 relative flex items-center rounded-full bg-gradient-to-r from-blue-900/70 via-blue-700/50 to-cyan-600/40 hover:from-blue-800/90 hover:to-cyan-500/60 backdrop-blur-xl border border-white/20 hover:border-white/40 shadow-[inset_0_1px_1px_rgba(255,255,255,0.3)] shadow-xl text-white w-40 lg:w-auto lg:min-w-[165px] h-11 px-5 transition-all duration-300 shrink-0 hover:scale-105 active:scale-95"
      >
        <!-- Fast centreret ikon til venstre -->
        <span class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 flex items-center justify-center pointer-events-none">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h6v6H4V6zm10 0h6v6h-6V6zM4 16h6v6H4v-6zm10 0h6v6h-6v-6z"></path>
          </svg>
        </span>
        <!-- Tekst -->
        <span class="w-full text-center text-sm font-medium pl-4">Features</span>
      </a>

      <!-- Join button -->
      <button
        id="open-signup"
        class="glass-card order-3 lg:order-2 relative flex items-center rounded-full bg-gradient-to-r from-red-900/70 via-rose-700/50 to-rose-500/50 hover:from-red-800/90 hover:to-rose-400/60 backdrop-blur-xl border border-white/20 hover:border-white/40 shadow-[inset_0_1px_1px_rgba(255,255,255,0.3)] shadow-xl text-white w-40 lg:w-auto lg:min-w-[165px] h-11 px-5 transition-all duration-300 shrink-0 hover:scale-105 active:scale-95 cursor-pointer"
      >
        <!-- Fast centreret ikon til venstre -->
        <span class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 flex items-center justify-center pointer-events-none">
          <img src="/assets/icons/pencil-icon-white.png" alt="Join" class="w-4 h-4 brightness-0 invert object-contain" />
        </span>
        <!-- Tekst -->
        <span class="w-full text-center text-sm font-medium pl-4">Join?</span>
      </button>
    </div>

    <!-- Join Modal -->
    <div id="signup-modal" class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/60 backdrop-blur-sm p-4">
      <div class="bg-white/95 rounded-2xl p-6 lg:p-8 w-full max-w-md shadow-2xl relative overflow-hidden border border-white/40">
        <button id="close-signup" class="absolute top-4 right-4 z-20 text-gray-400 hover:text-gray-700 text-xl leading-none"> × </button>
        <img src="/dursia-logo.png" alt="" class="absolute inset-0 m-auto w-80 opacity-10 pointer-events-none select-none" />

        <div class="relative z-10">
          <h2 class="text-xl lg:text-2xl font-semibold text-gray-900 mb-1 text-center">Join DURSIA?</h2>
          <p class="text-gray-500 text-xs lg:text-sm mb-5 text-center">Leave your details below:</p>

          <form id="signup-form" action="https://formspree.io/f/xvkpgkra" method="POST" class="space-y-3 lg:space-y-4">
            <div>
              <label class="block text-xs lg:text-sm text-gray-600 mb-1">Name</label>
              <input type="text" name="name" required class="w-full rounded-2xl border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Your name" />
            </div>

            <!-- Reason -->
            <div>
              <label class="block text-xs lg:text-sm text-gray-600 mb-1.5">Reason</label>
              <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-xs lg:text-sm text-gray-700">
                <label class="inline-flex items-center gap-1.5 cursor-pointer">
                  <input type="radio" name="reason" value="Programmer" required class="text-blue-600 focus:ring-blue-500" />
                  <span>I'm a programmer</span>
                </label>
                <label class="inline-flex items-center gap-1.5 cursor-pointer">
                  <input type="radio" name="reason" value="Investor" required class="text-blue-600 focus:ring-blue-500" />
                  <span>I'm an investor</span>
                </label>
                <label class="inline-flex items-center gap-1.5 cursor-pointer">
                  <input type="radio" name="reason" value="Other" required class="text-blue-600 focus:ring-blue-500" />
                  <span>Other</span>
                </label>
              </div>
            </div>

            <div>
              <label class="block text-xs lg:text-sm text-gray-600 mb-1">Comments</label>
              <textarea name="comments" rows="2" required class="w-full rounded-2xl border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 resize-none" placeholder="Your skill level / link to work / comments"
              ></textarea>
            </div>

            <!-- Phone (1/3) og Email (2/3) på samme linje -->
            <div class="grid grid-cols-3 gap-3">
              <div class="col-span-1">
                <label class="block text-xs lg:text-sm text-gray-600 mb-1">Phone</label>
                <input type="tel" name="phone" class="w-full rounded-2xl border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Your phone" />
              </div>

              <div class="col-span-2">
                <label class="block text-xs lg:text-sm text-gray-600 mb-1">Email</label>
                <input type="email" name="email" required class="w-full rounded-2xl border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Your email" />
              </div>
            </div>

            <button type="submit" class="w-full mt-2 rounded-2xl bg-gradient-to-r from-red-600 to-rose-500 hover:from-red-500 hover:to-rose-400 text-white font-medium py-2.5 transition text-sm"> Send </button>
          </form>
        </div>
      </div>
    </div>
  </main>
</MainLayout>

<style>
  /* ------------------------------------------------------------- */
  /* MOBIL LODRET (< 1024px): AFSKÆRING TIL 2 LINJER OG EXPAND    */
  /* ------------------------------------------------------------- */
  @media (max-width: 1023px) and (orientation: portrait) {
    /* Når teksten er lukket sammen på mobil */
    #text-content.mobile-collapsed {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
  }

  /* ------------------------------------------------------------- */
  /* DESKTOP OG VANDRET VIEW (1024px+): ALDRIG BEGRÆNSNING ELLER PIL */
  /* ------------------------------------------------------------- */
  @media (min-width: 1024px) {
    #text-content {
      display: block !important;
      overflow: visible !important;
      -webkit-line-clamp: none !important;
      height: auto !important;
    }

    #expand-arrow-wrapper {
      display: none !important;
    }
  }

  /* VIDEO REGULERING */
  .video-item {
    height: auto;
    width: 88vw;
    max-width: 380px;
    aspect-ratio: 4 / 3;
    border-radius: 14px;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.45);
    display: block;
    object-fit: cover;
  }

  @media (min-width: 1024px) {
    .video-item {
      height: clamp(240px, 41vh, 340px) !important;
      width: auto !important;
      max-width: 85vw !important;
      aspect-ratio: auto !important;
      object-fit: cover !important;
    }
  }

  /* MOBIL LANDSCAPE (LIGGENDE MOBIL) */
  @media (orientation: landscape) and (max-width: 1023px) {
    main {
      height: auto !important;
      min-height: 100vh !important;
      overflow-y: auto !important;
      padding-top: 1.5rem !important;
      padding-bottom: 5rem !important;
      display: flex !important;
      flex-direction: column !important;
      align-items: center !important;
      justify-content: flex-start !important;
      gap: 1.5rem !important;
    }

    main > div:first-child {
      flex-direction: row !important;
      flex-wrap: nowrap !important;
      justify-content: center !important;
      align-items: stretch !important;
      gap: 0.75rem !important;
      padding-left: 1rem !important;
      padding-right: 1rem !important;
    }

    main > div:first-child > div:first-child,
    main > div:first-child > div:last-child {
      width: 22% !important;
      max-width: 180px !important;
      min-width: 140px !important;
      font-size: 0.75rem !important;
      padding: 0.5rem 0.75rem !important;
    }

    main > div:first-child > div:nth-child(2) {
      width: 52% !important;
      max-width: 480px !important;
      font-size: 0.75rem !important;
      line-height: 1.25 !important;
      padding: 0.5rem 0.85rem !important;
    }

    #text-content {
      display: block !important;
      overflow: visible !important;
      -webkit-line-clamp: none !important;
    }

    #expand-arrow-wrapper {
      display: none !important;
    }

    .video-item {
      height: 48vh !important;
      max-height: 210px !important;
      width: auto !important;
      aspect-ratio: auto !important;
      object-fit: cover !important;
    }

    a[href="/demo"] {
      display: inline-flex !important;
    }

    main > div:has(a[href="/demo"]) {
      flex-direction: row !important;
      flex-wrap: nowrap !important;
      justify-content: center !important;
      align-items: center !important;
      gap: 1rem !important;
      width: 100% !important;
      margin-top: 0.5rem !important;
    }

    main > div:has(a[href="/demo"]) a,
    main > div:has(a[href="/demo"]) button {
      width: auto !important;
      min-width: 120px !important;
      padding-left: 1rem !important;
      padding-right: 1rem !important;
      font-size: 0.875rem !important;
    }
  }
</style>

<script>
  const setupIndex = () => {
    // 1. VIDEO AUTOPLAY LOGIK
    const video = document.querySelector("video");
    if (video) {
      video.muted = true;
      video.playsInline = true;
      video.play().catch(() => {
        document.body.addEventListener("click", () => video.play(), { once: true });
      });
    }

    // 2. TEKSTBOKS EXPAND LOGIK (KUN MOBIL PORTRAIT)
    const textBox = document.getElementById("expandable-text-box");
    const textContent = document.getElementById("text-content");
    const expandArrowWrapper = document.getElementById("expand-arrow-wrapper");

    if (textBox && textContent && expandArrowWrapper) {
      // Start med at lukke teksten på mobil
      if (window.innerWidth < 1024) {
        textContent.classList.add("mobile-collapsed");
      }

      textBox.addEventListener("click", () => {
        // Kør KUN hvis skærmen er i lodret mobil-view (< 1024px)
        if (window.innerWidth < 1024) {
          const isCollapsed = textContent.classList.contains("mobile-collapsed");

          if (isCollapsed) {
            // Fold ud
            textContent.classList.remove("mobile-collapsed");
            expandArrowWrapper.classList.add("hidden");
            expandArrowWrapper.classList.remove("flex");
          } else {
            // Fold sammen
            textContent.classList.add("mobile-collapsed");
            expandArrowWrapper.classList.remove("hidden");
            expandArrowWrapper.classList.add("flex");
          }
        }
      });
    }

    // 3. SIGNUP MODAL LOGIK
    const openBtn = document.getElementById("open-signup");
    const closeBtn = document.getElementById("close-signup");
    const modal = document.getElementById("signup-modal");
    const form = document.getElementById("signup-form") as HTMLFormElement | null;
    const submitBtn = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null;

    openBtn?.addEventListener("click", () => {
      modal?.classList.remove("hidden");
      modal?.classList.add("flex");
    });

    closeBtn?.addEventListener("click", () => {
      modal?.classList.add("hidden");
      modal?.classList.remove("flex");
    });

    modal?.addEventListener("click", (e) => {
      if (e.target === modal) {
        modal.classList.add("hidden");
        modal.classList.remove("flex");
      }
    });

    form?.addEventListener("submit", async (e) => {
      e.preventDefault();

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerText = "Sending...";
      }

      const formData = new FormData(form);

      try {
        const response = await fetch(form.action, {
          method: form.method,
          body: formData,
          headers: { Accept: "application/json" },
        });

        if (response.ok) {
          alert("Thank you! We'll notify you when DURSIA is ready.");
          form.reset();
          modal?.classList.add("hidden");
          modal?.classList.remove("flex");
        } else {
          alert("Oops! There was a problem submitting your form. Please try again.");
        }
      } catch (error) {
        alert("Oops! There was a network error. Please try again.");
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerText = "Send";
        }
      }
    });
  };

  // Kør ved load og Astro View Transitions
  document.addEventListener("DOMContentLoaded", setupIndex);
  document.addEventListener("astro:page-load", setupIndex);
</script>
