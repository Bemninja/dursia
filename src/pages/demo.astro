---
import MainLayout from "../layouts/MainLayout.astro";
import IconButton from "../components/IconButton.astro";
---

<MainLayout title="DURSIA - Demo">
  <main class="relative w-full h-screen overflow-hidden flex justify-center items-center">
    <!-- Back button (Hævet sikkert over Mikrolegat-logoet i bunden) -->
    <IconButton href="/">
      <img src="/assets/icons/arrow-back.svg" alt="back arrow" class="fixed bottom-10 right-4 md:bottom-14 md:right-8 z-50 w-12 h-12 rounded-full bg-black/40 p-2 backdrop-blur-sm hover:bg-black/60 transition" />
    </IconButton>

    <!-- Demo video med download-beskyttelse og deaktiveret højreklik -->
    <video controls loop playsinline oncontextmenu="return false;" class="relative z-10 h-[85vh] w-fit max-w-[90vw] object-contain">
      <source src="/assets/video/dursia-demo-2026.mp4" type="video/mp4" />
      Din browser understøtter ikke video-tagget.
    </video>
  </main>
</MainLayout>
