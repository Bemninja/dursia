---
import MainLayout from "../layouts/MainLayout.astro";
import IconButton from "../components/IconButton.astro";
---

<MainLayout title="DURSIA - Demo">
  <main class="relative w-full h-screen overflow-hidden flex justify-center items-center">
    <!-- Back button -->
    <IconButton href="/">
      <img src="/assets/icons/arrow-back.svg" alt="back arrow" class="fixed bottom-4 right-4 z-50 w-14 h-14 md:bottom-8 md:right-8 rounded-full bg-black/40 p-2 backdrop-blur-sm hover:bg-black/60 transition" />
    </IconButton>

    <!-- Demo video med download-beskyttelse og deaktiveret højreklik -->
    <video autoplay controls muted playsinline controlsList="nodownload" oncontextmenu="return false;" class="relative z-10 h-[85vh] w-fit max-w-[90vw] rounded-xl shadow-2xl object-contain bg-transparent">
      <source src="/assets/video/dursia-demo-82mb.mp4" type="video/mp4" />
    </video>
  </main>
</MainLayout>
